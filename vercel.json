{
  "version": 2,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/((?!api|admin|images|assets).*)$", "destination": "/index.html" }
  ]
}
