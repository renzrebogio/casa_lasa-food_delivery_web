# ==========================================
# Casa Lasa - Environment Variables Template
# ==========================================

# 1. MongoDB Database Connection
# In Vercel, set this in: Project Settings -> Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.qe3oobr.mongodb.net/react-food-delivery-app

# 2. Authentication Secret (Random secure string)
JWT_SECRET=your_jwt_secret_key_here

# 3. Stripe Secret Key (for payments)
STRIPE_SECRET_KEY=sk_test_...

# 4. Application URL (Optional on Vercel, automatically detected)
# Set this to your production domain or custom domain if needed:
# FRONTEND_URL=https://your-app.vercel.app

# 5. Vercel Blob Storage (Optional, automatically provided if Vercel Blob is enabled in dashboard)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
